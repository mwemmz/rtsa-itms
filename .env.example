# Shared team PostgreSQL. Locally the team database listens on port 3330:
#   postgresql://<user>:<password>@localhost:3330/rtsa_itms
# Once the shared Neon database exists, swap in its connection string (…?sslmode=require).
DATABASE_URL=postgresql://user:password@localhost:3330/rtsa_itms
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
# Set to true in production so migrations + seed run at app startup (Render free tier).
RUN_MIGRATIONS_ON_STARTUP=false

# --- Security -------------------------------------------------------------
# Fernet key for encryption at rest (MFA secrets, gateway payloads). If empty, derived from SECRET_KEY.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# true behind Render/any TLS-terminating proxy
FORCE_HTTPS=false
# Trust X-Forwarded-For (only behind a proxy that appends the client IP, e.g. Render)
TRUST_PROXY_HEADERS=false
# comma separated origins; empty = same-origin only
CORS_ORIGINS=
SESSION_IDLE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=8
REQUIRE_MFA_FOR_STAFF=false
# Password for the seeded admin (default demo password is used if unset - set it in production!)
ADMIN_INITIAL_PASSWORD=

# --- Notifications (leave empty for sandbox: messages are logged, not sent) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@rtsa.gov.zm
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- Inter-agency ---------------------------------------------------------------
# empty = sandbox (format check only)
NATIONAL_ID_API_URL=
NATIONAL_ID_API_TOKEN=

# --- Performance / operations ---------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SLOW_REQUEST_MS=500
REPORT_CACHE_SECONDS=30
BACKUP_DIR=backups
BACKUP_RETENTION=14
